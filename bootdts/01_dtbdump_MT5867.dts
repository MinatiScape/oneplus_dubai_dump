/dts-v1/;

/ {
	#address-cells = <0x2>;
	#size-cells = <0x2>;
	compatible = "arm,foundation-arm", "arm,mt5867";
	interrupt-parent = <0x1>;
	model = "MT5867";

	AFEC_VSYNC {
		compatible = "AFEC_VSYNC";
		interrupts = <0x0 0x5c 0x4>;
	};

	AUDMA_V2_INTR {
		compatible = "AUDMA_V2_INTR";
		interrupts = <0x0 0x16 0x4>;
	};

	AU_DMA_BUFFER_INT_EDGE {
		compatible = "AU_DMA_BUFFER_INT_EDGE";
		interrupts = <0x0 0x61 0x4>;
	};

	AU_SPDIF_TX_CS_INT_0 {
		compatible = "AU_SPDIF_TX_CS_INT_0";
		interrupts = <0x0 0x77 0x4>;
	};

	AU_SPDIF_TX_CS_INT_1 {
		compatible = "AU_SPDIF_TX_CS_INT_1";
		interrupts = <0x0 0x78 0x4>;
	};

	DSP2MIPS_INT {
		compatible = "DSP2MIPS_INT";
		interrupts = <0x0 0x5f 0x4>;
	};

	DSP_MIU_PROT_intr {
		compatible = "DSP_MIU_PROT_intr";
		interrupts = <0x0 0x52 0x4>;
	};

	HDMI_NON_PCM_MODE_INT_OUT {
		compatible = "HDMI_NON_PCM_MODE_INT_OUT";
		interrupts = <0x0 0x4b 0x4>;
	};

	INT_CCFL {
		compatible = "INT_CCFL";
		interrupts = <0x0 0x59 0x4>;
	};

	MB_DSP2toMCU_INT_0 {
		compatible = "MB_DSP2toMCU_INT_0";
		interrupts = <0x0 0x46 0x4>;
	};

	MB_DSP2toMCU_INT_1 {
		compatible = "MB_DSP2toMCU_INT_1";
		interrupts = <0x0 0x47 0x4>;
	};

	MB_auR2toMCU_INT_0 {
		compatible = "MB_auR2toMCU_INT_0";
		interrupts = <0x0 0x44 0x4>;
	};

	MB_auR2toMCU_INT_1 {
		compatible = "MB_auR2toMCU_INT_1";
		interrupts = <0x0 0x45 0x4>;
	};

	Mstar-STR {

		Mstar-mbx {
			resume-stage1 = "noirq";
			suspend-stage1 = "noirq";
		};

		Mstar-utopia2k-str {
			policy = "async";
			resume-stage1 = "early";
			resume-stage1-waitfor = "mstar_mci.0";
			suspend-stage1 = "late";
		};

		mmcblk {
			resume-stage1 = "noirq";
			suspend-stage1 = "noirq";
		};

		mmcbus {
			resume-stage1 = "early";
			suspend-stage1 = "late";
		};

		mstar-xc {
			resume-stage1 = "noirq";
			suspend-stage1 = "noirq";
		};

		mstar_mci {
			policy = "async";
			resume-stage1 = "early";
			suspend-stage1 = "late";
		};
	};

	Mstar-ehci-1 {
		compatible = "Mstar-ehci-1";
	};

	Mstar-ehci-2 {
		compatible = "Mstar-ehci-2";
	};

	Mstar-ehci-3 {
		compatible = "Mstar-ehci-3";
	};

	Mstar-ehci-4 {
		compatible = "Mstar-ehci-4";
	};

	Mstar-lp-standby {
		compatible = "Mstar-lp-standby";
	};

	Mstar-otg {
		compatible = "Mstar-otg";
		interrupts = <0x0 0x6 0x4 0x0 0x7 0x4>;
	};

	Mstar-sys {

		firmware {

			audio {
				path = "/vendor/lib/utopia/audio_bin/";
			};

			vdec {
				path = "/vendor/lib/utopia/vdec_bin/";
			};

			vdec_fw {
				path = "/vendor/lib/utopia/vdec_bin/";
			};
		};
	};

	Mstar-udc {
		compatible = "Mstar-udc";
		interrupts = <0x0 0x16 0x4>;
	};

	Mstar-utopia2k-str {
		compatible = "Mstar-utopia2k-str";

		ace {

			resume {

				stage0 {
					post-condition = "ace";
					pre-condition = "xc";
				};
			};

			suspend {

				stage0 {
					post-condition = "ace";
				};
			};
		};

		avd {

			resume {

				stage0 {
					post-condition = "avd";
					pre-condition = "vif";
				};
			};
		};

		dmx {

			resume {

				stage0 {
					post-condition = "dmx";
					pre-condition = "dscmb";
				};
			};

			suspend {

				stage0 {
					post-condition = "dmx";
					pre-condition = "dscmb";
				};
			};
		};

		dscmb {

			resume {

				stage0 {
					post-condition = "dscmb";
				};
			};

			suspend {

				stage0 {
					post-condition = "dscmb";
				};
			};
		};

		hdmi_rx {

			resume {

				stage0 {
					post-condition = "hdmi_rx";
				};
			};
		};

		mhl {

			resume {

				stage0 {
					pre-condition = "hdmi_rx";
				};
			};
		};

		miu {

			resume {

				stage0 {
					post-condition = "miu";
				};
			};
		};

		mvop {

			resume {

				stage0 {
					post-condition = "mvop";
				};
			};
		};

		pnl {

			resume {

				stage0 {
					post-condition = "pnl";
				};
			};

			suspend {

				stage0 {
					pre-condition = "xc";
				};
			};
		};

		pq {

			resume {

				stage0 {
					post-condition = "pq";
					pre-condition = "xc";
				};
			};

			suspend {

				stage0 {
					post-condition = "pq";
				};
			};
		};

		vdec {

			resume {

				stage0 {
					post-condition = "vdec";
				};
			};
		};

		ve {

			resume {

				stage0 {
					pre-condition = "miu", "xc";
				};
			};
		};

		vif {

			resume {

				stage0 {
					post-condition = "vif";
				};
			};
		};

		xc {

			resume {

				stage0 {
					post-condition = "xc";
					pre-condition = "vdec", "avd", "miu", "mvop", "pnl";
				};
			};

			suspend {

				stage0 {
					post-condition = "xc";
					pre-condition = "pq", "ace";
				};
			};
		};
	};

	PAS_PTS_INTRL_COMBINE {
		compatible = "PAS_PTS_INTRL_COMBINE";
		interrupts = <0x0 0xa7 0x4>;
	};

	SE_DSP2UP_intr {
		compatible = "SE_DSP2UP_intr";
		interrupts = <0x0 0x4e 0x4>;
	};

	SPDIF_IN_NON_PCM_INT_OUT {
		compatible = "SPDIF_IN_NON_PCM_INT_OUT";
		interrupts = <0x0 0x4c 0x4>;
	};

	__symbols__ {
		EMAC_MEM = "/mmap_info/EMAC_MEM";
		E_MMAP_ID_ARMFW_MEM = "/mmap_info/E_MMAP_ID_ARMFW_MEM";
		E_MMAP_ID_HW_AES_BUF = "/mmap_info/E_MMAP_ID_HW_AES_BUF";
		E_MMAP_ID_IOMMU_MPU_TABLE = "/mmap_info/E_MMAP_ID_IOMMU_MPU_TABLE";
		E_MMAP_ID_OPTEE_MEM = "/mmap_info/E_MMAP_ID_OPTEE_MEM";
		E_MMAP_ID_OPTEE_MEM_SHM = "/mmap_info/E_MMAP_ID_OPTEE_MEM_SHM";
		MEMC_VGSYNC_DATA_BUFFER = "/mmap_info/MEMC_VGSYNC_DATA_BUFFER";
		MI_ABF_BUF = "/mmap_info/MI_ABF_BUF";
		MI_ADL_B2R = "/mmap_info/MI_ADL_B2R";
		MI_AISR_STATISTIC_BUF = "/mmap_info/MI_AISR_STATISTIC_BUF";
		MI_AN_RECOVERY_BUF = "/mmap_info/MI_AN_RECOVERY_BUF";
		MI_AUCOMM_MEM = "/mmap_info/MI_AUCOMM_MEM";
		MI_AUDIO_CPU_1 = "/mmap_info/MI_AUDIO_CPU_1";
		MI_AUDIO_CPU_2 = "/mmap_info/MI_AUDIO_CPU_2";
		MI_BOOTLOGO_BUF = "/mmap_info/MI_BOOTLOGO_BUF";
		MI_CM4_VOICE = "/mmap_info/MI_CM4_VOICE";
		MI_CMDQ_BUF = "/mmap_info/MI_CMDQ_BUF";
		MI_CONTROLMAP_BUF = "/mmap_info/MI_CONTROLMAP_BUF";
		MI_DISPOUT_DEMURA = "/mmap_info/MI_DISPOUT_DEMURA";
		MI_DISPOUT_LOCAL_DIMMING = "/mmap_info/MI_DISPOUT_LOCAL_DIMMING";
		MI_DISP_AUTO_DOWNLOAD = "/mmap_info/MI_DISP_AUTO_DOWNLOAD";
		MI_DISP_AUTO_UPLOAD = "/mmap_info/MI_DISP_AUTO_UPLOAD";
		MI_DISP_CONFIG_MEMORY = "/mmap_info/MI_DISP_CONFIG_MEMORY";
		MI_DISP_CUS_SWREG_MEMORY = "/mmap_info/MI_DISP_CUS_SWREG_MEMORY";
		MI_DISP_GUCD_DMA = "/mmap_info/MI_DISP_GUCD_DMA";
		MI_DISP_LOCALCOLOR_DMA = "/mmap_info/MI_DISP_LOCALCOLOR_DMA";
		MI_DISP_PHOTO_BUF = "/mmap_info/MI_DISP_PHOTO_BUF";
		MI_DISP_PQ_DF_MEMORY_LAYER = "/mmap_info/MI_DISP_PQ_DF_MEMORY_LAYER";
		MI_DISP_PQ_MEMORY = "/mmap_info/MI_DISP_PQ_MEMORY";
		MI_DISP_SRS_MEMORY = "/mmap_info/MI_DISP_SRS_MEMORY";
		MI_DMD_DVBT = "/mmap_info/MI_DMD_DVBT";
		MI_DRAMC_HW_TRACKING = "/mmap_info/MI_DRAMC_HW_TRACKING";
		MI_DV_DMA_BUF = "/mmap_info/MI_DV_DMA_BUF";
		MI_DV_PYR_BUF = "/mmap_info/MI_DV_PYR_BUF";
		MI_EFUSE = "/mmap_info/MI_EFUSE";
		MI_EXTIN_VD_COMB_BUF = "/mmap_info/MI_EXTIN_VD_COMB_BUF";
		MI_FRC_FW_MEM = "/mmap_info/MI_FRC_FW_MEM";
		MI_FRC_SHM = "/mmap_info/MI_FRC_SHM";
		MI_GE_VQCMD_BUF = "/mmap_info/MI_GE_VQCMD_BUF";
		MI_GOP_REGDMA_BASE = "/mmap_info/MI_GOP_REGDMA_BASE";
		MI_GOP_RPMSG = "/mmap_info/MI_GOP_RPMSG";
		MI_HDMIRX_MEM_SHM = "/mmap_info/MI_HDMIRX_MEM_SHM";
		MI_HWI2C_MEM = "/mmap_info/MI_HWI2C_MEM";
		MI_JPD_INTER_BUF = "/mmap_info/MI_JPD_INTER_BUF";
		MI_JPD_OUT = "/mmap_info/MI_JPD_OUT";
		MI_JPD_READ_BUF = "/mmap_info/MI_JPD_READ_BUF";
		MI_KERNEL1_RANGE0 = "/mmap_info/MI_KERNEL1_RANGE0";
		MI_KERNEL1_RANGE1 = "/mmap_info/MI_KERNEL1_RANGE1";
		MI_KERNEL1_RANGE2 = "/mmap_info/MI_KERNEL1_RANGE2";
		MI_KERNEL_POOL1 = "/mmap_info/MI_KERNEL_POOL1";
		MI_KERNEL_POOL2 = "/mmap_info/MI_KERNEL_POOL2";
		MI_MAD_ADV_BUF = "/mmap_info/MI_MAD_ADV_BUF";
		MI_MAD_DEC_BUF = "/mmap_info/MI_MAD_DEC_BUF";
		MI_MAD_SE_BUF = "/mmap_info/MI_MAD_SE_BUF";
		MI_MBOOT_MEM_USAGE = "/mmap_info/MI_MBOOT_MEM_USAGE";
		MI_MCDI_BUF = "/mmap_info/MI_MCDI_BUF";
		MI_MCU_DS = "/mmap_info/MI_MCU_DS";
		MI_MEMC_MV_BUFFER = "/mmap_info/MI_MEMC_MV_BUFFER";
		MI_MEMC_REALDATA = "/mmap_info/MI_MEMC_REALDATA";
		MI_MENULOAD_BUF = "/mmap_info/MI_MENULOAD_BUF";
		MI_METADATA_BUF = "/mmap_info/MI_METADATA_BUF";
		MI_MMAP_CFD_BUF = "/mmap_info/MI_MMAP_CFD_BUF";
		MI_ONLY_STR_BUF = "/mmap_info/MI_ONLY_STR_BUF";
		MI_PMU_MSPI_MEM = "/mmap_info/MI_PMU_MSPI_MEM";
		MI_PMU_RPMSG_RSCTABLE = "/mmap_info/MI_PMU_RPMSG_RSCTABLE";
		MI_PMU_RPMSG_VDEV = "/mmap_info/MI_PMU_RPMSG_VDEV";
		MI_PMU_RPMSG_VRING0 = "/mmap_info/MI_PMU_RPMSG_VRING0";
		MI_PMU_RPMSG_VRING1 = "/mmap_info/MI_PMU_RPMSG_VRING1";
		MI_PQMAP_BUF = "/mmap_info/MI_PQMAP_BUF";

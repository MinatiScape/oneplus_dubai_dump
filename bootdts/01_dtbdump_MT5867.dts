		MI_PQU_SHM = "/mmap_info/MI_PQU_SHM";
		MI_PQU_SHMCTRL = "/mmap_info/MI_PQU_SHMCTRL";
		MI_RENDER_METADATA = "/mmap_info/MI_RENDER_METADATA";
		MI_SRCCAP_SWREG_BUF = "/mmap_info/MI_SRCCAP_SWREG_BUF";
		MI_STREAMON_METADATA = "/mmap_info/MI_STREAMON_METADATA";
		MI_STR_LDR_BUF = "/mmap_info/MI_STR_LDR_BUF";
		MI_TEE_LOADER = "/mmap_info/MI_TEE_LOADER";
		MI_TSO_FILEIN_BUF = "/mmap_info/MI_TSO_FILEIN_BUF";
		MI_TSP_FW_BUF = "/mmap_info/MI_TSP_FW_BUF";
		MI_TSP_SECT_BUF = "/mmap_info/MI_TSP_SECT_BUF";
		MI_TSP_SVQ_BUF = "/mmap_info/MI_TSP_SVQ_BUF";
		MI_TSP_VQ_BUF = "/mmap_info/MI_TSP_VQ_BUF";
		MI_VBI_BUF = "/mmap_info/MI_VBI_BUF";
		MI_VDEC_CC_RAW_DATA = "/mmap_info/MI_VDEC_CC_RAW_DATA";
		MI_VDEC_FRAME_BUF = "/mmap_info/MI_VDEC_FRAME_BUF";
		MI_VDEC_SHARE_MEM = "/mmap_info/MI_VDEC_SHARE_MEM";
		MI_VE_FRAME_BUF = "/mmap_info/MI_VE_FRAME_BUF";
		MI_VOC_OWL = "/mmap_info/MI_VOC_OWL";
		MI_ZNR_BUF = "/mmap_info/MI_ZNR_BUF";
		UCD_SHM_BUFFER = "/mmap_info/UCD_SHM_BUFFER";
		backlight = "/backlight";
		cluster0 = "/cpus/cpu-map/cluster0";
		cma_22 = "/reserved-memory/cma_22";
		cma_23 = "/reserved-memory/cma_23";
		cpu0 = "/cpus/cpu@0";
		cpu1 = "/cpus/cpu@1";
		cpu2 = "/cpus/cpu@2";
		cpu3 = "/cpus/cpu@3";
		cpu_opp_table = "/opp-table";
		default_cma_range = "/reserved-memory/default_cma";
		extcon_gpio = "/extcon-headset";
		firmware = "/firmware";
		gpio = "/gpio";
		gpio_wifi_ctl = "/gpio_wifi_ctl";
		i2c0 = "/i2c@0";
		i2c1 = "/i2c@1";
		iommu = "/iommu";
		iommu_carveout = "/reserved-memory/iommu_carveout@cv0";
		iommu_carveout0 = "/iommu_carveout0";
		iommu_cma1 = "/reserved-memory/iommu_cma1@cm1";
		iommu_cma2 = "/reserved-memory/iommu_cma2@cm2";
		iommu_cmaheap1 = "/iommu_cmaheap1";
		iommu_dmaheap = "/iommu_dmaheap";
		iommu_test = "/iommu_test";
		ion_iommu = "/ion";
		keypad = "/keypad";
		mem_cust_policy = "/mem_cust_policy";
		memory_info = "/memory_info";
		mtk_demod = "/mtk-demod";
		mtk_disp_photo = "/mtk-disp-photo";
		mtk_edmc = "/edmc@1078c000";
		mtk_mdla = "/mdla";
		mtk_mmap = "/mmap_info";
		mtk_sensor0 = "/mtk-sensor@0";
		mtk_thermal = "/thermal-zones/mtk-thermal";
		mtk_tsp_sect = "/mtk-tsp-sect";
		mtk_vd = "/mtk-vd";
		mtktv_regulator = "/mtktv-regulator";
		overtemp_point = "/thermal-zones/mtk-thermal/trips/trip-point@1";
		reserved_memory = "/reserved-memory";
		reset_point = "/thermal-zones/mtk-thermal/trips/trip-point@2";
		switch_gpio = "/switch_gpio";
	};

	acpu_int {
		compatible = "acpu_int";
		interrupts = <0x0 0x3c 0x4>;
	};

	adcdvi2riu_int {
		compatible = "adcdvi2riu_int";
		interrupts = <0x0 0xf 0x4>;
	};

	adcpll_int {
		compatible = "adcpll_int";
		interrupts = <0x0 0xbc 0x4>;
	};

	aesdma_s_int {
		compatible = "aesdma_s_int";
		interrupts = <0x0 0xc0 0x4>;
	};

	alsa {
		compatible = "Mstar-alsa";
	};

	backlight {
		bl_ctrl = <0xb>;
		bl_ctrl_inverse = <0x0>;
		brightness-levels = <0x0 0xff>;
		compatible = "backlight";
		default-brightness-level = <0xff>;
		led_gpio = <0x6>;
		led_gpio_invert = <0x0>;
		phandle = <0x85>;
		vcc_gpio = <0x9>;
		vcc_gpio_invert = <0x0>;
	};

	buf_tag {

		cap_more {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0x53>;
			max_size = <0x0 0xc00000>;
			miu = <0x0>;
			normal_zone = <0x0>;
		};

		cap_once {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0x51>;
			max_size = <0x0 0x800000>;
			miu = <0x0>;
			normal_zone = <0x0>;
		};

		cap_once_ge {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0x52>;
			max_size = <0x0 0x800000>;
			miu = <0x0>;
			normal_zone = <0x0>;
		};

		directfb_frame0 {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0xe>;
			max_size = <0x0 0x8000000>;
			miu = <0x0>;
			normal_zone = <0x0>;
		};

		directfb_frame1 {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0xf>;
			max_size = <0x0 0x1200000>;
			miu = <0x0>;
			normal_zone = <0x0>;
		};

		disp_photo {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0xd>;
			max_size = <0x0 0x4000000>;
			miu = <0x0>;
			normal_zone = <0x0>;
		};

		factory_osd {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0x55>;
			max_size = <0x0 0x800000>;
			miu = <0x0>;
			normal_zone = <0x0>;
		};

		fbdev {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0x56>;
			max_size = <0x0 0x4000000>;
			miu = <0x0>;
			normal_zone = <0x0>;
		};

		img_frame {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0x9>;
			max_size = <0x0 0x2000000>;
			miu = <0x0>;
			normal_zone = <0x0>;

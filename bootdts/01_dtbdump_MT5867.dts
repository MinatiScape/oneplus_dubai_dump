			trips {

				trip-point@1 {
					hysteresis = <0x3e8>;
					phandle = <0x12>;
					temperature = <0x20f58>;
					type = "passive";
				};

				trip-point@2 {
					hysteresis = <0x3e8>;
					phandle = <0x8a>;
					temperature = <0x249f0>;
					type = "hot";
				};
			};
		};
	};

	timer {
		clock-frequency = <0xb71b00>;
		compatible = "arm,mstar-timer-workaround", "arm,armv8-timer";
		interrupts = <0x1 0xd 0xff01 0x1 0xe 0xff01 0x1 0xb 0xff01 0x1 0xa 0xff01>;
	};


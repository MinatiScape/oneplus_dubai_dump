	qos {
		ctrl_reg_opt = <0x0 0x0 0x0 0x0>;
		dts_version = <0x1 0x0>;

		cpu {

			output-map {

				AIPQ-1 {
					id = <0x1>;
					output_set = <0x0 0x1 0x2 0x3 0x4 0x5 0x6 0x7>;
					owner = "AIPQ";
				};

				AIPQ-2 {
					id = <0x2>;
					output_set = <0x0 0x0 0x0 0x0 0x0 0x0 0x7 0x7>;
					owner = "AIPQ";
				};

				EPOLL-1 {
					id = <0x1>;
					output_set = <0x0 0x1 0x2 0x3 0x4 0x5 0x6 0x7>;
					owner = "epoll";
				};

				UCD-1 {
					id = <0x1>;
					output_set = <0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x7>;
					owner = "UCD";
				};

				WRITER-1 {
					id = <0x1>;
					owner = "writer";

					write-0 {
						output_set = "2", "64", "128", "256", "512", "768", "896", "1024";
						path = "/dev/cpuctl/limit/cpu.shares";
					};

					write-1 {
						output_set = "5000", "6000", "7000", "8000", "10000", "-1", "-1", "-1";
						path = "/dev/cpuctl/limit/cpu.cfs_quota_us";
					};
				};

				WRITER-2 {
					id = <0x2>;
					owner = "writer";

					write-0 {
						output_set = "FROZEN", "FROZEN", "THAWED", "THAWED", "THAWED", "THAWED", "THAWED", "THAWED";
						path = "/dev/freezer/hate/freezer.state";
					};
				};
			};

			registry {

				keep-0 {
					comm_pid = "system_server";
					comm_tid = "InputDispatcher";
					path = "/dev/cpuctl/limit/tasks";
					pid_num = <0x1>;
					target = "TID";
					tid_num = <0x1>;
				};
			};

			scenarios {

				SD {
					delay_ctrl = <0x0 0x0 0x0 0x0>;
					init_ctrl = <0x7>;
					output_map = <0x0 0x2 0x0 0x1>;
					trigger_map = <0x5a>;

					input-events {
						video = <0x0 0x2 0x0 0x0>;
					};
				};

				SD-key {
					delay_ctrl = <0x0 0x0 0x0 0x0>;
					init_ctrl = <0x5>;
					output_map = <0x1 0x2 0x0 0x1>;
					trigger_map = <0x5a>;

					input-events {
						key_press = <0x1>;
						video = <0x0 0x2 0x0 0x0>;
						voice = <0x0>;
					};
				};

				SD-voc {
					delay_ctrl = <0x0 0x0 0x0 0x0>;
					init_ctrl = <0x5>;
					output_map = <0x0 0x2 0x0 0x1>;
					trigger_map = <0x55>;

					input-events {
						key_press = <0x0>;
						video = <0x0 0x2 0x0 0x0>;
						voice = <0x1>;
					};
				};

				SD-voc-key {
					delay_ctrl = <0x1 0x1 0x0 0x1>;
					init_ctrl = <0x3>;
					output_map = <0x1 0x2 0x0 0x1>;
					trigger_map = <0x50>;

					input-events {
						key_press = <0x1>;
						video = <0x0 0x2 0x0 0x0>;
						voice = <0x1>;
					};
				};

				default {
					output_map = <0x0 0x0 0x0 0x0>;
					trigger_map = <0x3e7>;

					input-events {
						video = <0x0 0x0 0x0 0x0>;
					};
				};

				default-key {
					output_map = <0x1 0x0 0x0 0x1>;
					trigger_map = <0x5a>;

					input-events {
						key_press = <0x1>;
						video = <0x0 0x0 0x0 0x0>;
					};
				};

				default-voc {
					output_map = <0x0 0x0 0x0 0x0>;
					trigger_map = <0x3e7>;

					input-events {
						video = <0x0 0x0 0x0 0x0>;
						voice = <0x1>;
					};
				};

				default-voc-key {
					output_map = <0x1 0x0 0x0 0x1>;
					trigger_map = <0x5a>;

					input-events {
						key_press = <0x1>;
						video = <0x0 0x0 0x0 0x0>;
						voice = <0x1>;
					};
				};
			};
		};
	};


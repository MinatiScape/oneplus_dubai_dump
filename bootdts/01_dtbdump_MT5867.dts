		inject_filein {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0x57>;
			max_size = <0x0 0x200000>;
			miu = <0x0>;
			mmap_name = "MI_INJECT_BUF";
			normal_zone = <0x0>;
		};

		inject_secure {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0x58>;
			max_size = <0x0 0x200000>;
			miu = <0x0>;
			mmap_name = "E_MMAP_ID_OPTEE_MEM_EXT";
			normal_zone = <0x0>;
		};

		jpd_inter {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0xc>;
			max_size = <0x0 0xd00000>;
			miu = <0x0>;
			normal_zone = <0x0>;
		};

		jpd_read {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0xb>;
			max_size = <0x0 0x500000>;
			miu = <0x0>;
			normal_zone = <0x0>;
		};

		jpd_write {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0xa>;
			max_size = <0x0 0x2000000>;
			miu = <0x0>;
			normal_zone = <0x0>;
		};

		mali_gop {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0x6>;
			max_size = <0x0 0x19000000>;
			miu = <0x0>;
			normal_zone = <0x1>;
		};

		mali_gop_dma {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0x5>;
			max_size = <0x0 0x6000000>;
			miu = <0x0>;
			normal_zone = <0x0>;
		};

		mdla_buf {
			cache = <0x2>;
			heaptype = <0x0>;
			id = <0x28>;
			max_size = <0x0 0xec00000>;
			miu = <0x0>;
			normal_zone = <0x0>;
		};

		mheg_inter {
			cache = <0x2>;
